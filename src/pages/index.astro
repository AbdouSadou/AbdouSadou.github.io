---
import Base from '../layouts/Base.astro';
import MetaRail from '../components/MetaRail.astro';
import Hero from '../components/Hero.astro';
import ProofBand from '../components/ProofBand.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Experience from '../components/Experience.astro';
import Teaching from '../components/Teaching.astro';
import Certifications from '../components/Certifications.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { SITE } from '../consts';

// JSON-LD Person (spec §10.3)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Abdou Sadou',
  jobTitle: 'Data Governance & BI Consultant',
  worksFor: {
    '@type': 'Organization',
    name: 'One1Star Solutions',
  },
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'University of Huddersfield',
    },
    {
      '@type': 'CollegeOrUniversity',
      name: 'USTHB (University of Science and Technology Houari Boumediene)',
    },
  ],
  knowsAbout: [
    'data governance',
    'master data management',
    'master data quality',
    'ISO 8000',
    'business intelligence',
    'big data',
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'Master Data Quality Manager (ISO 8000-110)',
    credentialCategory: 'certification',
    url: 'https://eccma.org/forms/certificationdirectory/cert_content/ECCMA.MDQM:2026073100',
    recognizedBy: {
      '@type': 'Organization',
      name: 'ECCMA',
    },
  },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'West Yorkshire',
    addressCountry: 'GB',
  },
  sameAs: [SITE.linkedin, SITE.github],
};
---

<Base
  locale="en"
  hasTranslation
  title={SITE.title}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <MetaRail locale="en" />
  <Hero locale="en" />
  <ProofBand locale="en" />
  <SelectedWork locale="en" />
  <Experience locale="en" />
  <Teaching locale="en" />
  <Certifications locale="en" />
  <Skills locale="en" />
  <About locale="en" />
  <Contact locale="en" />
</Base>
