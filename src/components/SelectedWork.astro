    <rect x="540" y="232" width="24" height="4" rx="2" fill="var(--review)" opacity="0.8"/>
    <path d="M580 200h24m0 0-7-7m7 7-7 7" stroke="var(--review)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
