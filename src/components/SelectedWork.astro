    <rect x="428" y="185" width="40" height="6" rx="3" fill="var(--chart-slate)" opacity="0.65"/>
    <rect x="64" y="288" width="64" height="36" rx="8" fill="var(--surface-2)" stroke="var(--chart-slate)" stroke-width="1.5"/>
    <rect x="76" y="303" width="40" height="6" rx="3" fill="var(--chart-slate)" opacity="0.65"/>
    <rect x="224" y="288" width="64" height="36" rx="8" fill="var(--surface-2)" stroke="var(--verified)" stroke-width="1.5"/>
    <path d="M245 306l7 7 13-13" stroke="var(--verified)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="352" y="288" width="64" height="36" rx="8" fill="var(--surface-2)" stroke="var(--chart-slate)" stroke-width="1.5"/>
    <rect x="364" y="303" width="40" height="6" rx="3" fill="var(--chart-slate)" opacity="0.65"/>
    <rect x="512" y="288" width="64" height="36" rx="8" fill="var(--surface-2)" stroke="var(--review)" stroke-width="1.5"/>
    <rect x="524" y="303" width="40" height="6" rx="3" fill="var(--chart-slate)" opacity="0.65"/>
  </svg>`,

  // Network graph over a ledger grid: change tracking as a ruled registry,
  // one change in amber dash, one node verified, a violet lineage edge.
  'network-change-registry': `<svg viewBox="0 0 640 400" width="640" height="400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <g stroke="var(--chart-slate)" stroke-width="1" opacity="0.18">
      <line x1="32" y1="60" x2="608" y2="60"/>
      <line x1="32" y1="100" x2="608" y2="100"/>
      <line x1="32" y1="140" x2="608" y2="140"/>
      <line x1="32" y1="180" x2="608" y2="180"/>
      <line x1="32" y1="220" x2="608" y2="220"/>
      <line x1="32" y1="260" x2="608" y2="260"/>
      <line x1="32" y1="300" x2="608" y2="300"/>
      <line x1="32" y1="340" x2="608" y2="340"/>
    </g>
    <line x1="96" y1="36" x2="96" y2="364" stroke="var(--review)" stroke-width="1" opacity="0.4"/>
    <g fill="var(--chart-slate)" opacity="0.4">
      <rect x="48" y="78" width="32" height="4" rx="2"/>
      <rect x="48" y="118" width="32" height="4" rx="2"/>
      <rect x="48" y="158" width="32" height="4" rx="2"/>
      <rect x="48" y="198" width="32" height="4" rx="2"/>
