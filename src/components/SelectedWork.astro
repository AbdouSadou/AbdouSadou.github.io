    <path d="M260 277C316 277 340 222 384 206" stroke="var(--lineage)" stroke-width="1.5"/>
    <rect x="388" y="180" width="40" height="40" rx="6" stroke="var(--chart-slate)" stroke-width="1.5"/>
    <rect x="436" y="180" width="40" height="40" rx="6" stroke="var(--chart-slate)" stroke-width="1.5"/>
    <rect x="484" y="180" width="40" height="40" rx="6" stroke="var(--chart-slate)" stroke-width="1.5"/>
    <rect x="532" y="180" width="40" height="40" rx="6" stroke="var(--review)" stroke-width="1.5"/>
