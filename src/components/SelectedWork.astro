    <circle cx="320" cy="200" r="30" fill="var(--surface-2)" stroke="var(--verified)" stroke-width="1.5"/>
    <path d="M308 200l8 8 16-16" stroke="var(--verified)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`,

  // Branching tree of builder nodes: violet root, one evaluated path in
  // verified teal down to a ticked leaf, one leaf still under review.
  'decision-tree-builder': `<svg viewBox="0 0 640 400" width="640" height="400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
