---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n';
import { t } from '../i18n/work';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const strings = t[locale];

// Case cards (spec §5.3), ordered by frontmatter `order`:
// Inventara, Customer Data 360, Decision Tree Builder, Network Change Registry.
// Entry ids are '<locale>/<slug>' (en/inventara, fr/inventara, ...): keep the
// current locale's entries and derive the URL slug from the id's second half.
const cases = (await getCollection('work', (entry) => entry.id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order
);

// Duotone motifs (spec §7.5, §8.5): one abstract inline SVG per case, drawn
// only in palette colours. Desaturated at rest; lifts to full colour on
// hover/focus-within. 640×400 = fixed 16:10 with explicit dimensions (CLS 0).
