      <line x1="176" y1="120" x2="312" y2="84"/>
      <line x1="312" y1="84" x2="452" y2="140"/>
      <line x1="176" y1="120" x2="248" y2="240"/>
      <line x1="452" y1="140" x2="548" y2="228"/>
      <line x1="548" y1="228" x2="404" y2="288"/>
    </g>
    <line x1="312" y1="84" x2="248" y2="240" stroke="var(--lineage)" stroke-width="1.5" opacity="0.8"/>
    <line x1="248" y1="240" x2="404" y2="288" stroke="var(--review)" stroke-width="1.5" stroke-dasharray="4 6"/>
    <g stroke="var(--chart-slate)" stroke-width="1.5" fill="var(--surface-2)">
      <circle cx="176" cy="120" r="9"/>
      <circle cx="312" cy="84" r="9"/>
      <circle cx="248" cy="240" r="9"/>
      <circle cx="404" cy="288" r="9"/>
      <circle cx="548" cy="228" r="9"/>
    </g>
    <circle cx="452" cy="140" r="11" stroke="var(--verified)" stroke-width="1.5" fill="var(--surface-2)"/>
    <path d="M446 140l4 4 8-8" stroke="var(--verified)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`,
};
---

<section id="work" class="section" aria-labelledby="work-heading">
  <div class="container">
    <header class="section-header" data-reveal>
      <p class="eyebrow">{strings.eyebrow}</p>
      <h2 id="work-heading">{strings.heading}</h2>
    </header>

    <ul class="work-grid" role="list">
      {
        cases.map((entry, index) => (
          <li class="work-grid__item" data-reveal style={`transition-delay: ${index * 60}ms;`}>
            <article class="work-card">
              <div
                class="work-card__visual"
                aria-hidden="true"
                set:html={motifs[entry.id.split('/')[1]] ?? ''}
              />
              <div class="work-card__body">
                <h3 class="work-card__title">
                  <a
                    class="work-card__link"
                    href={`${locale === 'fr' ? '/fr' : ''}/work/${entry.id.split('/')[1]}/`}
                  >
                    {entry.data.title}
                  </a>
                </h3>
                <p class="work-card__outcome">{entry.data.outcome}</p>
                <ul class="work-card__chips" role="list">
                  {entry.data.stack.slice(0, 4).map((tool) => (
                    <li class="chip">{tool}</li>
                  ))}
                </ul>
                <span class="work-card__cta" aria-hidden="true">
                  {strings.readCaseStudy}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" focusable="false">
                    <path
                      d="M2 8h11M9 3.5 13.5 8 9 12.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 720px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* data-reveal lives on the <li> wrapper so the reveal transition (700ms)
     never competes with the card's own 220ms hover transitions. */
  .work-grid__item {
    display: flex;
  }

  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition:
      transform var(--dur-ui) var(--ease-out),
      border-color var(--dur-ui) var(--ease-out);
  }

  /* §8.5: 4px lift, border brightens; :focus-within mirrors hover so
     keyboard focus on the stretched link gets the same treatment. */
  .work-card:hover,
  .work-card:focus-within {
    transform: translateY(-4px);
    border-color: var(--line-bright);
  }

  .work-card__visual {
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  /* Duotone at rest → full colour on hover/focus (§8.5). Explicit 640×400
     attributes on the svg reserve the 16:10 box, so CLS stays at 0. */
  .work-card__visual svg {
    width: 100%;
    height: auto;
    opacity: 0.55;
    filter: saturate(0.4);
    transition:
      opacity var(--dur-ui) var(--ease-out),
      filter var(--dur-ui) var(--ease-out);
  }

  .work-card:hover .work-card__visual svg,
  .work-card:focus-within .work-card__visual svg {
    opacity: 1;
    filter: saturate(1);
  }

  .work-card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  /* Stretched link: the title anchor's ::after covers the card, so the
     whole card is one clean link named by the title text. */
  .work-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .work-card__outcome {
    color: var(--text-lo);
    font-size: var(--text-small);
  }

  .work-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .work-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    color: var(--verified);
    font-size: var(--text-small);
    font-weight: 550;
  }

  .work-card__cta svg {
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .work-card:hover .work-card__cta svg,
  .work-card:focus-within .work-card__cta svg {
    transform: translateX(4px);
  }
</style>
